{
  "name": "@freedomofpress/sigsum",
  "version": "0.4.0",
  "description": "A Sigsum proof verifier for the browser.",
  "repository": {
    "type": "git",
    "url": "https://github.com/freedomofpress/sigsum-ts"
  },
  "type": "module",
  "main": "dist/verify.js",
  "types": "dist/verify.d.ts",
  "exports": {
    ".": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "eslint . --fix && prettier --write .",
    "clean": "rm -rf dist/*"
  },
  "keywords": [
    "sigsum",
    "ed25519",
    "transparency",
    "browser",
    "typescript"
  ],
  "author": "Giulio B",
  "license": "MIT",
  "homepage": "https://github.com/freedomofpress/sigsum-ts#readme",
  "bugs": "https://github.com/freedomofpress/sigsum-ts/issues",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
